# Banco de dados (SQLite em dev, PostgreSQL em produção)
DATABASE_URL="file:./prisma/dev.db"

# Autenticação JWT (gere uma string aleatória longa)
JWT_SECRET="troque-por-um-segredo-forte-de-pelo-menos-32-caracteres"

# Segredo do webhook interno WhatsApp (opcional, recomendado em produção)
WEBHOOK_SECRET="seu-segredo-do-webhook"

# URL pública do app (para documentação e links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
