# Banco de dados (SQLite em dev, PostgreSQL em produção)
DATABASE_URL="file:./prisma/dev.db"

# Autenticação JWT (gere uma string aleatória longa)
JWT_SECRET="troque-por-um-segredo-forte-de-pelo-menos-32-caracteres"

# Segredo do webhook interno WhatsApp (opcional, recomendado em produção)
WEBHOOK_SECRET="seu-segredo-do-webhook"

# URL pública do app (para documentação e links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ──────────────────────────────────────────────────────
# APIs de fontes de dados (configuração opcional)
# ──────────────────────────────────────────────────────
# Sem essas chaves, as fontes operam em modo simulado.

# DataJud/CNJ — API pública de dados processuais (gratuita, requer cadastro)
# Cadastre-se em: https://datajud-wiki.cnj.jus.br/ para obter sua chave
DATAJUD_API_KEY=""

# JusBrasil — API comercial de dados jurídicos (requer contratação)
# Solicite em: https://conteudo.jusbrasil.com.br/api
JUSBRASIL_API_KEY=""

# BNMP — Banco Nacional de Mandados de Prisão (requer credenciamento PDPJ-Br)
# Acesso institucional via: https://portalbnmp.cnj.jus.br/
BNMP_API_KEY=""
BNMP_API_URL="https://portalbnmp.cnj.jus.br"