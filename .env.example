# Banco de dados (SQLite em dev, PostgreSQL em produção)
DATABASE_URL="file:./prisma/dev.db"

# Autenticação JWT (gere uma string aleatória longa)
JWT_SECRET="troque-por-um-segredo-forte-de-pelo-menos-32-caracteres"

# Segredo do webhook interno WhatsApp (opcional, recomendado em produção)
WEBHOOK_SECRET="seu-segredo-do-webhook"

# URL pública do app (para documentação e links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ──────────────────────────────────────────────────────
# APIs de fontes de dados
# ──────────────────────────────────────────────────────
# Sem essas chaves, as fontes retornam "indisponível"
# com orientações sobre como obter acesso.

# BNMP — Banco Nacional de Mandados de Prisão (CNJ)
# API via PDPJ-Br: requer credenciamento institucional
# Docs: https://docs.pdpj.jus.br/servicos-negociais/bnmp/
BNMP_API_KEY=""
BNMP_API_URL="https://api.bnmp-integracao.stg.cloud.pje.jus.br"

# JusBrasil — API comercial de dados jurídicos (requer contratação)
# Solicite em: https://conteudo.jusbrasil.com.br/api
JUSBRASIL_API_KEY=""
JUSBRASIL_API_URL="https://api.jusbrasil.com.br"

# DataJud — API pública de dados processuais (NÃO permite consulta por pessoa)
# A API pública não expõe o campo `partes` (LGPD).
# Mantida para referência, mas não usada em consultas por pessoa.
DATAJUD_API_KEY=""